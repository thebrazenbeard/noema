{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noema:experiment-preregistration-manifest:v2",
  "title": "Noema Experiment Preregistration Manifest V2",
  "description": "IP_CONFIDENTIAL. Inert preregistration schema. Validation never authorizes execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","classification","status","subject","effect_boundary","information_boundary","candidates","world","stream_contract","resource_contract","audition_scope_contract","lineage_transfer_contract","scoring_contract","statistics_contract","controls","restart_contract","freeze_contract","comparator_fairness_contract"],
  "properties": {
    "schema_version": {"const": "NOEMA_EXPERIMENT_PREREGISTRATION_MANIFEST_V2"},
    "classification": {"enum": ["IP_CONFIDENTIAL","IP_REVIEW_REQUIRED"]},
    "status": {"const": "PREREGISTERED_INERT_UNTIL_SEPARATE_EXECUTION_AUTHORITY"},
    "subject": {"$ref": "#/$defs/subject"},
    "effect_boundary": {"$ref": "#/$defs/effect_boundary"},
    "information_boundary": {"$ref": "#/$defs/information_boundary"},
    "candidates": {"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/candidate"}},
    "world": {"$ref":"#/$defs/world"},
    "stream_contract": {"$ref":"#/$defs/stream_contract"},
    "resource_contract": {"$ref":"#/$defs/resource_contract"},
    "audition_scope_contract": {"$ref":"#/$defs/audition_scope_contract"},
    "lineage_transfer_contract": {"$ref":"#/$defs/lineage_transfer_contract"},
    "scoring_contract": {"$ref":"#/$defs/scoring_contract"},
    "statistics_contract": {"$ref":"#/$defs/statistics_contract"},
    "controls": {"$ref":"#/$defs/controls"},
    "restart_contract": {"$ref":"#/$defs/restart_contract"},
    "freeze_contract": {"$ref":"#/$defs/freeze_contract"},
    "comparator_fairness_contract": {"$ref":"#/$defs/artifact_ref"}
  },
  "allOf": [
    {
      "if": {"properties":{"subject":{"properties":{"stage":{"const":"SVF-0"}},"required":["stage"]}}},
      "then": {"properties":{
        "candidates":{"allOf":[
          {"contains":{"properties":{"role":{"const":"C1"}},"required":["role"]}},
          {"contains":{"properties":{"role":{"const":"C2"}},"required":["role"]}}
        ]},
        "world":{"properties":{
          "intervention_mode":{"const":"NONE"},
          "passive_observational_equivalence_required":{"const":false},
          "intervention_schedule_artifact":{"type":"null"},
          "intervention_schedule_commitment":{"type":"null"}
        }},
        "audition_scope_contract":{"properties":{
          "learned_scope_primary_claim_allowed":{"const":false},
          "simple_audition_rival_required":{"const":false}
        }},
        "scoring_contract":{"properties":{
          "primary_claims":{"type":"array","minItems":1,"maxItems":1,"items":{"const":"P"}},
          "c2_vs_c4_external_comparison_required":{"const":false}
        }}
      }}
    },
    {
      "if": {"properties":{"subject":{"properties":{"stage":{"const":"SVF-1"}},"required":["stage"]}}},
      "then": {"properties":{
        "candidates":{"allOf":[
          {"contains":{"properties":{"role":{"const":"C2"}},"required":["role"]}},
          {"contains":{"properties":{"role":{"const":"C4"}},"required":["role"]}}
        ]},
        "world":{"properties":{
          "intervention_mode":{"const":"EXTERNALLY_SCHEDULED"},
          "passive_observational_equivalence_required":{"const":true},
          "intervention_schedule_artifact":{"$ref":"#/$defs/artifact_ref"},
          "intervention_schedule_commitment":{"$ref":"#/$defs/sha256"},
          "observational_equivalence_verification":{"type":"object","additionalProperties":false,"required":["analytic_check","numeric_check","numeric_tolerance"],"properties":{"analytic_check":{"const":true},"numeric_check":{"const":true},"numeric_tolerance":{"type":"number","exclusiveMinimum":0}}},
          "schedule_may_adapt_to_hidden_family":{"const":false},
          "schedule_may_adapt_to_candidate_predictions":{"const":false},
          "schedule_may_adapt_to_scored_outcomes":{"const":false},
          "schedule_may_adapt_to_evaluator_diagnostics":{"const":false}
        }},
        "audition_scope_contract":{"properties":{"simple_audition_rival_required":{"const":true},"simple_audition_probability":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
        "scoring_contract":{"properties":{
          "primary_claims":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["S","T","L","G"]}},
          "c2_vs_c4_external_comparison_required":{"const":true}
        }},
        "controls":{"properties":{
          "semantic_cheat_diagnostic":{"const":true},
          "intervention_blind_ablation":{"const":true},
          "replay_ablation":{"const":true},
          "reset_refit_diagnostic":{"const":true},
          "premature_commitment_ablation":{"const":true},
          "uniform_audition_rival":{"const":true},
          "negative_structural_value_worlds":{"const":true}
        }}
      }}
    }
  ],
  "$defs": {
    "sha40": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nonempty": {"type":"string","minLength":1},
    "artifact_ref": {
      "type":"object","additionalProperties":false,
      "required":["repository","commit","path"],
      "properties":{
        "repository":{"$ref":"#/$defs/nonempty"},
        "commit":{"$ref":"#/$defs/sha40"},
        "path":{"$ref":"#/$defs/nonempty"},
        "git_blob":{"$ref":"#/$defs/sha40"},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "subject": {
      "type":"object","additionalProperties":false,
      "required":["project","repository","design_base_commit","implementation_subject_commit","implementation_subject_manifest","schema_artifact","validator_artifact","comparator_fairness_artifact","resource_addendum_artifact","decidability_addendum_artifact","comparator_matrix_addendum_artifact","comparator_interface_artifact","experiment_family","stage","manifest_logical_id","created_at"],
      "properties":{
        "project":{"const":"Noema"},
        "repository":{"const":"thebrazenbeard/noema"},
        "design_base_commit":{"$ref":"#/$defs/sha40"},
        "implementation_subject_commit":{"$ref":"#/$defs/sha40"},
        "implementation_subject_manifest":{"$ref":"#/$defs/artifact_ref"},
        "schema_artifact":{"$ref":"#/$defs/artifact_ref"},
        "validator_artifact":{"$ref":"#/$defs/artifact_ref"},
        "comparator_fairness_artifact":{"$ref":"#/$defs/artifact_ref"},
        "resource_addendum_artifact":{"$ref":"#/$defs/artifact_ref"},
        "decidability_addendum_artifact":{"$ref":"#/$defs/artifact_ref"},
        "comparator_matrix_addendum_artifact":{"$ref":"#/$defs/artifact_ref"},
        "comparator_interface_artifact":{"$ref":"#/$defs/artifact_ref"},
        "experiment_family":{"const":"MINIMAL_STRUCTURAL_VALUE_FALSIFICATION"},
        "stage":{"enum":["SVF-0","SVF-1"]},
        "manifest_logical_id":{"$ref":"#/$defs/nonempty"},
        "created_at":{"type":"string","format":"date-time"},
        "supersedes_manifest":{"oneOf":[{"$ref":"#/$defs/artifact_ref"},{"type":"null"}]}
      }
    },
    "effect_boundary": {
      "type":"object","additionalProperties":false,
      "required":["execution","training","paid_compute","merge","deployment","publication","provider_or_credential_mutation","repository_visibility_change","separate_execution_authority_required"],
      "properties":{
        "execution":{"const":false},
        "training":{"const":false},
        "paid_compute":{"const":false},
        "merge":{"const":false},
        "deployment":{"const":false},
        "publication":{"const":false},
        "provider_or_credential_mutation":{"const":false},
        "repository_visibility_change":{"const":false},
        "separate_execution_authority_required":{"const":true}
      }
    },
    "information_boundary": {
      "type":"object","additionalProperties":false,
      "required":["information_condition_id","learner_visible_schema","evaluator_only_schema","learner_visible_field_names","evaluator_only_field_names","field_sets_must_be_disjoint","forbidden_learner_ingress"],
      "properties":{
        "information_condition_id":{"$ref":"#/$defs/nonempty"},
        "learner_visible_schema":{"$ref":"#/$defs/artifact_ref"},
        "evaluator_only_schema":{"$ref":"#/$defs/artifact_ref"},
        "learner_visible_field_names":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/nonempty"}},
        "evaluator_only_field_names":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/nonempty"}},
        "field_sets_must_be_disjoint":{"const":true},
        "forbidden_learner_ingress":{
          "type":"object","additionalProperties":false,
          "required":["semantic_applicability_labels","hidden_world_state","future_derived_targets","evaluator_score","exact_intervention_success_truth"],
          "properties":{
            "semantic_applicability_labels":{"const":false},
            "hidden_world_state":{"const":false},
            "future_derived_targets":{"const":false},
            "evaluator_score":{"const":false},
            "exact_intervention_success_truth":{"const":false}
          }
        }
      }
    },
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","role","source_commit","source_artifacts","base_substrate_id","variant_of_candidate_id","variant_dimension","information_condition_id","opportunity_condition_id","resource_condition_id","replay_policy_id","scope_policy_id","developmental_evidence_eligible"],
      "properties":{
        "candidate_id":{"$ref":"#/$defs/nonempty"},
        "role":{"enum":["C0","C1","C2","C3","C4","REFERENCE","ORACLE_DIAGNOSTIC","CHEAT_DIAGNOSTIC"]},
        "source_commit":{"$ref":"#/$defs/sha40"},
        "source_artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact_ref"}},
        "base_substrate_id":{"oneOf":[{"$ref":"#/$defs/nonempty"},{"type":"null"}]},
        "variant_of_candidate_id":{"oneOf":[{"$ref":"#/$defs/nonempty"},{"type":"null"}]},
        "variant_dimension":{"oneOf":[{"enum":["NONE","REPLAY","SCOPE_POLICY","PREMATURE_COMMITMENT","INTERVENTION_VISIBILITY","META_LEARNING","RESET_REFIT","OTHER_PREREGISTERED"]},{"type":"null"}]},
        "information_condition_id":{"$ref":"#/$defs/nonempty"},
        "opportunity_condition_id":{"$ref":"#/$defs/nonempty"},
        "resource_condition_id":{"$ref":"#/$defs/nonempty"},
        "replay_policy_id":{"$ref":"#/$defs/nonempty"},
        "scope_policy_id":{"$ref":"#/$defs/nonempty"},
        "developmental_evidence_eligible":{"type":"boolean"}
      },
      "allOf":[
        {
          "if":{"properties":{"role":{"enum":["REFERENCE","ORACLE_DIAGNOSTIC","CHEAT_DIAGNOSTIC"]}},"required":["role"]},
          "then":{"properties":{"developmental_evidence_eligible":{"const":false}}},
          "else":{"properties":{"developmental_evidence_eligible":{"const":true}}}
        },
        {
          "if":{"properties":{"role":{"enum":["C1","C2","C4"]}},"required":["role"]},
          "then":{"properties":{"base_substrate_id":{"$ref":"#/$defs/nonempty"}}}
        }
      ]
    },
    "world": {
      "type":"object","additionalProperties":false,
      "required":["generator","parameter_distribution_artifact","parameter_distribution_commitment","seed_manifest_artifact","seed_commitment","hidden_family_randomization_rule","intervention_mode","intervention_schedule_artifact","intervention_schedule_commitment","schedule_may_adapt_to_hidden_family","schedule_may_adapt_to_candidate_predictions","schedule_may_adapt_to_scored_outcomes","schedule_may_adapt_to_evaluator_diagnostics","passive_observational_equivalence_required","observational_equivalence_verification","negative_control_generator","negative_control_acceptance_rule"],
      "properties":{
        "generator":{"$ref":"#/$defs/artifact_ref"},
        "parameter_distribution_artifact":{"$ref":"#/$defs/artifact_ref"},
        "parameter_distribution_commitment":{"$ref":"#/$defs/sha256"},
        "seed_manifest_artifact":{"$ref":"#/$defs/artifact_ref"},
        "seed_commitment":{"$ref":"#/$defs/sha256"},
        "hidden_family_randomization_rule":{"$ref":"#/$defs/nonempty"},
        "intervention_mode":{"enum":["NONE","EXTERNALLY_SCHEDULED"]},
        "intervention_schedule_artifact":{"oneOf":[{"$ref":"#/$defs/artifact_ref"},{"type":"null"}]},
        "intervention_schedule_commitment":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "schedule_may_adapt_to_hidden_family":{"type":"boolean"},
        "schedule_may_adapt_to_candidate_predictions":{"type":"boolean"},
        "schedule_may_adapt_to_scored_outcomes":{"type":"boolean"},
        "schedule_may_adapt_to_evaluator_diagnostics":{"type":"boolean"},
        "passive_observational_equivalence_required":{"type":"boolean"},
        "observational_equivalence_verification":{"oneOf":[
          {"type":"object","additionalProperties":false,"required":["analytic_check","numeric_check","numeric_tolerance"],"properties":{"analytic_check":{"const":true},"numeric_check":{"const":true},"numeric_tolerance":{"type":"number","exclusiveMinimum":0}}},
          {"type":"null"}
        ]},
        "negative_control_generator":{"$ref":"#/$defs/artifact_ref"},
        "negative_control_acceptance_rule":{"$ref":"#/$defs/nonempty"}
      }
    },
    "stream_contract": {
      "type":"object","additionalProperties":false,
      "required":["opportunity_condition_id","temporal_order_preserved","predictions_committed_before_outcome","full_history_automatic_refit_allowed","identical_stream_for_primary_c2_c4","missingness_states_preserved","max_events_per_world","max_external_interventions_per_world"],
      "properties":{
        "opportunity_condition_id":{"$ref":"#/$defs/nonempty"},
        "temporal_order_preserved":{"const":true},
        "predictions_committed_before_outcome":{"const":true},
        "full_history_automatic_refit_allowed":{"const":false},
        "identical_stream_for_primary_c2_c4":{"type":"boolean"},
        "missingness_states_preserved":{"const":true},
        "max_events_per_world":{"type":"integer","minimum":1},
        "max_external_interventions_per_world":{"type":"integer","minimum":0}
      }
    },
    "resource_contract": {
      "type":"object","additionalProperties":false,
      "required":["resource_condition_id","measurement_method","measurement_artifact","fixed_total_envelope","replay_limits","structural_limits"],
      "properties":{
        "resource_condition_id":{"$ref":"#/$defs/nonempty"},
        "measurement_method":{"$ref":"#/$defs/nonempty"},
        "measurement_artifact":{"$ref":"#/$defs/artifact_ref"},
        "fixed_total_envelope":{
          "type":"object","additionalProperties":false,
          "required":["max_resident_memory_bytes","max_durable_state_bytes","max_update_cpu_seconds_per_event","max_query_cpu_seconds_per_event","max_shadow_auditions_per_event"],
          "properties":{
            "max_resident_memory_bytes":{"type":"integer","minimum":1},
            "max_durable_state_bytes":{"type":"integer","minimum":1},
            "max_update_cpu_seconds_per_event":{"type":"number","exclusiveMinimum":0},
            "max_query_cpu_seconds_per_event":{"type":"number","exclusiveMinimum":0},
            "max_shadow_auditions_per_event":{"type":"integer","minimum":0}
          }
        },
        "replay_limits":{
          "type":"object","additionalProperties":false,
          "required":["replay_policy_id","raw_buffer_capacity_events","max_replay_updates_per_event","replay_compute_charged","priority_provenance_declared"],
          "properties":{
            "replay_policy_id":{"$ref":"#/$defs/nonempty"},
            "raw_buffer_capacity_events":{"type":"integer","minimum":0},
            "max_replay_updates_per_event":{"type":"integer","minimum":0},
            "replay_compute_charged":{"const":true},
            "priority_provenance_declared":{"const":true}
          }
        },
        "structural_limits":{
          "type":"object","additionalProperties":false,
          "required":["max_active_candidates","max_proposals_per_event","structural_memory_charged","scope_compute_charged","audition_compute_charged","base_shadow_compute_charged"],
          "properties":{
            "max_active_candidates":{"type":"integer","minimum":0},
            "max_proposals_per_event":{"type":"integer","minimum":0},
            "structural_memory_charged":{"const":true},
            "scope_compute_charged":{"const":true},
            "audition_compute_charged":{"const":true},
            "base_shadow_compute_charged":{"const":true}
          }
        }
      }
    },
    "audition_scope_contract": {
      "type":"object","additionalProperties":false,
      "required":["scope_policy_ids","learned_scope_primary_claim_allowed","scope_ticket_required_before_outcome","audition_separate_from_candidate_influence","simple_audition_rival_required","simple_audition_probability","selection_probability_logged_before_outcome","zero_support_confidence_allowed","off_policy_estimator_may_override_zero_support","representation_drift_requires_support_disposition","support_class_thresholds"],
      "properties":{
        "scope_policy_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/nonempty"}},
        "learned_scope_primary_claim_allowed":{"type":"boolean"},
        "scope_ticket_required_before_outcome":{"type":"boolean"},
        "audition_separate_from_candidate_influence":{"const":true},
        "simple_audition_rival_required":{"type":"boolean"},
        "simple_audition_probability":{"oneOf":[{"type":"number","exclusiveMinimum":0,"maximum":1},{"type":"null"}]},
        "selection_probability_logged_before_outcome":{"const":true},
        "zero_support_confidence_allowed":{"const":false},
        "off_policy_estimator_may_override_zero_support":{"const":false},
        "representation_drift_requires_support_disposition":{"const":true},
        "support_class_thresholds":{"type":"object","minProperties":1,"additionalProperties":{"type":"number","minimum":0}}
      }
    },
    "lineage_transfer_contract": {
      "type":"object","additionalProperties":false,
      "required":["cross_world_transfer_used","policy_artifact","matched_candidate_carryover_required","state_scope_manifest_required","state_scope_manifest_artifacts","evaluator_lineage_ids_learner_visible","reset_and_continue_conditions_distinguished"],
      "properties":{
        "cross_world_transfer_used":{"type":"boolean"},
        "policy_artifact":{"oneOf":[{"$ref":"#/$defs/artifact_ref"},{"type":"null"}]},
        "matched_candidate_carryover_required":{"const":true},
        "state_scope_manifest_required":{"const":true},
        "state_scope_manifest_artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact_ref"}},
        "evaluator_lineage_ids_learner_visible":{"const":false},
        "reset_and_continue_conditions_distinguished":{"const":true}
      }
    },
    "metric": {
      "type":"object","additionalProperties":false,
      "required":["metric_id","claim","direction","comparator_candidate_id","aggregation_rule","threshold_rule","support_requirement"],
      "properties":{
        "metric_id":{"$ref":"#/$defs/nonempty"},
        "claim":{"enum":["P","S","T","L","G"]},
        "direction":{"enum":["HIGHER_IS_BETTER","LOWER_IS_BETTER"]},
        "comparator_candidate_id":{"$ref":"#/$defs/nonempty"},
        "aggregation_rule":{"$ref":"#/$defs/nonempty"},
        "threshold_rule":{"$ref":"#/$defs/nonempty"},
        "support_requirement":{"$ref":"#/$defs/nonempty"}
      }
    },
    "scoring_contract": {
      "type":"object","additionalProperties":false,
      "required":["proper_scoring_rule","primary_claims","primary_metrics","c2_vs_c4_external_comparison_required","c4_internal_base_shadow_diagnostic","counterfactual_unobserved_never_scored_as_observed","post_result_metric_substitution_allowed"],
      "properties":{
        "proper_scoring_rule":{"$ref":"#/$defs/nonempty"},
        "primary_claims":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["P","S","T","L","G"]}},
        "primary_metrics":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/metric"}},
        "c2_vs_c4_external_comparison_required":{"type":"boolean"},
        "c4_internal_base_shadow_diagnostic":{"type":"boolean"},
        "counterfactual_unobserved_never_scored_as_observed":{"const":true},
        "post_result_metric_substitution_allowed":{"const":false}
      }
    },
    "statistics_contract": {
      "type":"object","additionalProperties":false,
      "required":["seed_count","confidence_level","uncertainty_method","multiple_comparison_rule","stopping_rule","maximum_worlds","kill_criteria"],
      "properties":{
        "seed_count":{"type":"integer","minimum":2},
        "confidence_level":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
        "uncertainty_method":{"$ref":"#/$defs/nonempty"},
        "multiple_comparison_rule":{"$ref":"#/$defs/nonempty"},
        "stopping_rule":{"$ref":"#/$defs/nonempty"},
        "maximum_worlds":{"type":"integer","minimum":1},
        "kill_criteria":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonempty"}}
      }
    },
    "controls": {
      "type":"object","additionalProperties":false,
      "required":["semantic_cheat_diagnostic","intervention_blind_ablation","replay_ablation","reset_refit_diagnostic","premature_commitment_ablation","no_meta_learning_ablation","uniform_audition_rival","negative_structural_value_worlds"],
      "properties":{
        "semantic_cheat_diagnostic":{"type":"boolean"},
        "intervention_blind_ablation":{"type":"boolean"},
        "replay_ablation":{"type":"boolean"},
        "reset_refit_diagnostic":{"type":"boolean"},
        "premature_commitment_ablation":{"type":"boolean"},
        "no_meta_learning_ablation":{"type":"boolean"},
        "uniform_audition_rival":{"type":"boolean"},
        "negative_structural_value_worlds":{"type":"boolean"}
      }
    },
    "restart_contract": {
      "type":"object","additionalProperties":false,
      "required":["checkpointing_used","restart_equivalence_claimed","persist_outstanding_tickets","persist_unresolved_outcomes","persist_rng_state","persist_audit_policy_state","persist_support_intervals","persist_representation_boundaries","persist_stopping_rule_state","loss_of_required_state_forfeits_restart_equivalence"],
      "properties":{
        "checkpointing_used":{"type":"boolean"},
        "restart_equivalence_claimed":{"type":"boolean"},
        "persist_outstanding_tickets":{"type":"boolean"},
        "persist_unresolved_outcomes":{"type":"boolean"},
        "persist_rng_state":{"type":"boolean"},
        "persist_audit_policy_state":{"type":"boolean"},
        "persist_support_intervals":{"type":"boolean"},
        "persist_representation_boundaries":{"type":"boolean"},
        "persist_stopping_rule_state":{"type":"boolean"},
        "loss_of_required_state_forfeits_restart_equivalence":{"const":true}
      },
      "allOf":[
        {"if":{"properties":{"checkpointing_used":{"const":false}}},"then":{"properties":{"restart_equivalence_claimed":{"const":false}}}},
        {"if":{"properties":{"restart_equivalence_claimed":{"const":true}}},"then":{"properties":{
          "checkpointing_used":{"const":true},
          "persist_outstanding_tickets":{"const":true},
          "persist_unresolved_outcomes":{"const":true},
          "persist_rng_state":{"const":true},
          "persist_audit_policy_state":{"const":true},
          "persist_support_intervals":{"const":true},
          "persist_representation_boundaries":{"const":true},
          "persist_stopping_rule_state":{"const":true}
        }}}
      ]
    },
    "freeze_contract": {
      "type":"object","additionalProperties":false,
      "required":["outcome_visibility_before_freeze","mutable_after_freeze","change_after_freeze_creates_new_subject","freeze_receipt_locator","receipt_must_bind_manifest_commit_path_and_blob"],
      "properties":{
        "outcome_visibility_before_freeze":{"const":false},
        "mutable_after_freeze":{"const":false},
        "change_after_freeze_creates_new_subject":{"const":true},
        "freeze_receipt_locator":{"$ref":"#/$defs/nonempty"},
        "receipt_must_bind_manifest_commit_path_and_blob":{"const":true}
      }
    }
  },
  "x-noema-invariants": [
    "candidate_id and metric_id values are unique by key; validator-enforced.",
    "C2/C4 primary SVF-1 comparisons match base_substrate_id and information/opportunity/resource/replay conditions unless a difference is the explicitly isolated factor.",
    "Candidate condition IDs resolve to the frozen top-level contracts; scope_policy_id resolves to scope_policy_ids.",
    "Claim G requires variant-linked C4 learned-scope and simple-audition conditions identical except for the frozen scope-policy dimension.",
    "Learner-visible and evaluator-only fields are disjoint and immutable schemas are closed against metadata smuggling.",
    "SVF-1 schedule is frozen before outcome visibility and cannot adapt to hidden family, candidate predictions, scored outcomes, or evaluator diagnostics.",
    "Parameter, seed, and schedule commitments match their immutable artifact preimages.",
    "All scored prediction/action/scope decisions are committed before scored outcomes become visible.",
    "Replay cannot be post-hoc enriched with evaluator/future-derived labels.",
    "NOT_AUDITED, COUNTERFACTUAL_UNOBSERVED, unresolved, invalidated, success, and failure stay distinct.",
    "Primary metric claims appear in primary_claims and comparator_candidate_id resolves to a frozen allowed candidate/variant.",
    "Claim T requires frozen matched state-transfer lineage/carryover policy and no-meta-learning ablation.",
    "Claim G requires learned-scope permission, simple audition rival, and complete rival ledger.",
    "Zero/unknown support cannot satisfy strong scope claims; estimators cannot manufacture support.",
    "Representation changes explicitly close, transport, bridge, or relearn dependent support.",
    "Consumed replay/structure/scope/audition/base-shadow/checkpoint/probation resources are measured and charged.",
    "Post-freeze changes to source, boundaries, world/randomization/schedule, transfer policy, resources, scoring/support, controls, stopping, or acceptance create a new subject.",
    "Schema/validator PASS never constitutes execution, training, merge, deployment, spend, publication, credential/provider, ruleset, visibility, or protected-system authority."
  ]
}